{
  "name": "dialyrounds",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared && npm run build --workspace=client && npm run build --workspace=server",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "db:migrate:local": "npm run db:migrate:local --workspace=server",
    "db:seed:local": "npm run db:seed:local --workspace=server",
    "db:seed:mock:local": "npm run db:seed:mock:local --workspace=server",
    "db:reset-user:local": "npm run db:reset-user:local --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.7.2"
  }
}
