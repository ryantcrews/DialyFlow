{
  "name": "@dialyrounds/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run build --workspace=@dialyrounds/client && wrangler deploy --dry-run --outdir=dist",
    "deploy": "npm run build --workspace=@dialyrounds/client && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dialyrounds --local",
    "db:seed:local": "wrangler d1 execute dialyrounds --local --file=./scripts/seed.sql",
    "db:seed:mock:local": "node ./scripts/generate-mock-seed.mjs && wrangler d1 execute dialyrounds --local --file=./scripts/seed-mock-data.sql",
    "db:reset-user:local": "node ./scripts/reset-local-user.mjs",
    "db:reset:local": "node ./scripts/reset-local-db.mjs"
  },
  "dependencies": {
    "@dialyrounds/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.99.0"
  }
}
