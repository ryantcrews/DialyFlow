# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/dialyflow

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-256-bit-minimum
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Two-Factor Authentication
TWO_FACTOR_ISSUER=DialyFlow

# Default Admin User (for seeding)
ADMIN_EMAIL=admin@dialyflow.com
ADMIN_PASSWORD=Admin123!@#
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_TIMEOUT_MINUTES=60
